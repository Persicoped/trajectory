  "private": true,
  "description": "Open source, headless career ladder. How humans accelerate their growth in the AI workplace.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 4700",
