    "db:token": "tsx scripts/token.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@casl/ability": "7.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
